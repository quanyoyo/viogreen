---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
---
<BaseLayout title="Đăng nhập" noindex>
  <section class="section bg-cream">
    <div class="container-x mx-auto max-w-md">
      <div class="card p-6 sm:p-8">
        <div class="text-center">
          <span class="circle-ic mx-auto"><Icon name="user" /></span>
          <h1 class="mt-4 text-2xl font-extrabold" data-title>Đăng nhập</h1>
          <p class="mt-1 text-sm text-muted">Theo dõi đơn hàng và xem lại lịch sử mua hàng tại VIO GREEN.</p>
        </div>

        <button type="button" class="btn mt-6 w-full border border-line bg-white text-ink hover:border-brand hover:bg-cream" data-google>
          <Icon name="google" /> Tiếp tục với Google
        </button>

        <div class="my-6 flex items-center gap-3 text-xs text-muted"><span class="h-px flex-1 bg-line"></span>hoặc dùng email<span class="h-px flex-1 bg-line"></span></div>

        <div class="mb-5 grid grid-cols-2 rounded-full bg-cream-200 p-1 text-sm font-semibold" role="tablist">
          <button type="button" role="tab" class="rounded-full py-2 aria-selected:bg-white aria-selected:text-brand aria-selected:shadow-sm" aria-selected="true" data-tab="login">Đăng nhập</button>
          <button type="button" role="tab" class="rounded-full py-2 text-muted aria-selected:bg-white aria-selected:text-brand aria-selected:shadow-sm" aria-selected="false" data-tab="register">Tạo tài khoản</button>
        </div>

        <form class="space-y-4" data-auth-form="login" novalidate>
          <label class="field">Email<input class="input" name="email" type="email" required autocomplete="email" /></label>
          <label class="field">Mật khẩu<input class="input" name="password" type="password" required autocomplete="current-password" /></label>
          <div class="text-right"><button type="button" class="text-sm font-medium text-brand hover:underline" data-forgot>Quên mật khẩu?</button></div>
          <button class="btn btn-primary w-full" type="submit">Đăng nhập</button>
        </form>

        <form class="space-y-4" data-auth-form="register" novalidate hidden>
          <label class="field">Họ và tên<input class="input" name="name" required autocomplete="name" maxlength="100" /></label>
          <label class="field">Email<input class="input" name="email" type="email" required autocomplete="email" /></label>
          <label class="field">Mật khẩu<input class="input" name="password" type="password" required minlength="6" autocomplete="new-password" />
            <span class="text-xs font-normal text-muted">Ít nhất 6 ký tự.</span></label>
          <button class="btn btn-primary w-full" type="submit">Tạo tài khoản</button>
          <p class="text-xs text-muted">Bằng việc tạo tài khoản, bạn đồng ý với <a href="/chinh-sach/bao-mat/" class="underline">Chính sách bảo mật</a> của VIO GREEN.</p>
        </form>

        <p class="form-msg mt-4 text-center" data-auth-msg role="status"></p>
      </div>
    </div>
  </section>

  <script>
    import { currentUser, loginGoogle, loginEmail, register, resetPassword, authError } from '../../scripts/fb';
    import { $, $$ } from '../../scripts/ui';

    const raw = new URLSearchParams(location.search).get('next') || '';
    const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/tai-khoan/';
    const msg = $('[data-auth-msg]')!;
    const say = (text: string, state: 'ok' | 'error' | '' = 'error') => { msg.textContent = text; msg.dataset.state = state; };

    // Đã đăng nhập rồi thì đi tiếp luôn
    currentUser().then((u) => u && location.replace(next));

    // Chuyển tab Đăng nhập / Tạo tài khoản
    const tabs = $$<HTMLButtonElement>('[data-tab]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { x.setAttribute('aria-selected', String(x === t)); x.classList.toggle('text-muted', x !== t); });
      $$<HTMLFormElement>('[data-auth-form]').forEach((f) => (f.hidden = f.dataset.authForm !== t.dataset.tab));
      $('[data-title]')!.textContent = t.textContent;
      say('', '');
    }));

    async function run(btn: HTMLButtonElement, job: () => Promise<unknown>, redirect = true) {
      btn.disabled = true;
      say('', '');
      try {
        await job();
        if (redirect) location.replace(next);
      } catch (err) {
        console.error(err);
        say(authError(err));
      } finally {
        btn.disabled = false;
      }
    }

    const google = $<HTMLButtonElement>('[data-google]')!;
    google.addEventListener('click', () => run(google, loginGoogle));

    $$<HTMLFormElement>('[data-auth-form]').forEach((form) => form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        const bad = $<HTMLInputElement>(':invalid', form)!;
        bad.focus();
        return say(bad.name === 'password' && bad.value ? 'Mật khẩu cần ít nhất 6 ký tự.' : bad.name === 'email' && bad.value ? 'Email chưa hợp lệ.' : 'Vui lòng điền đủ thông tin.');
      }
      const f = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const btn = $<HTMLButtonElement>('button[type="submit"]', form)!;
      run(btn, () => form.dataset.authForm === 'register'
        ? register(f.name.trim(), f.email.trim(), f.password)
        : loginEmail(f.email.trim(), f.password));
    }));

    const forgot = $<HTMLButtonElement>('[data-forgot]')!;
    forgot.addEventListener('click', () => {
      const email = $<HTMLInputElement>('[data-auth-form="login"] [name="email"]')!;
      if (!email.value || !email.checkValidity()) { email.focus(); return say('Nhập email của bạn ở ô trên, rồi bấm "Quên mật khẩu?" lần nữa.'); }
      run(forgot, async () => {
        await resetPassword(email.value.trim());
        say(`Nếu ${email.value.trim()} đã có tài khoản, VIO GREEN đã gửi link đặt lại mật khẩu. Kiểm tra cả thư mục Spam nhé.`, 'ok');
      }, false);
    });
  </script>
</BaseLayout>
