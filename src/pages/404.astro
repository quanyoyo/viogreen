---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Không tìm thấy trang" noindex>
  <section class="section">
    <div class="container-x mx-auto max-w-xl text-center">
      <span class="mx-auto inline-flex size-24 items-center justify-center rounded-full bg-brand-50 text-brand"><Icon name="sprout" class="size-12" /></span>
      <p class="mt-6 text-6xl font-extrabold text-brand">404</p>
      <h1 class="mt-2 text-2xl font-bold">Trang này chưa nảy mầm</h1>
      <p class="mt-3 text-muted">Đường dẫn có thể đã thay đổi hoặc không tồn tại. Thử tìm sản phẩm bạn cần:</p>
      <form action="/san-pham/" method="get" class="mx-auto mt-6 flex max-w-md overflow-hidden rounded-full border border-line focus-within:border-brand">
        <input type="search" name="q" placeholder="ECOHUB, Bio-Tank…" aria-label="Tìm sản phẩm" class="min-h-12 w-full px-4 outline-none" />
        <button class="shrink-0 bg-brand px-5 font-semibold text-white">Tìm</button>
      </form>
      <div class="mt-6 flex justify-center gap-3"><a href="/" class="btn btn-primary">Về trang chủ</a><button type="button" class="btn btn-outline" data-open-chat><Icon name="chat" /> Hỏi MIO</button></div>
    </div>
  </section>
</BaseLayout>
