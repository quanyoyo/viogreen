---
import Icon from './Icon.astro';
import { reviews } from '../data/reviews';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Lọc các đánh giá tĩnh cho sản phẩm này
const staticReviews = reviews.filter(
  (r) => r.productSlug === product.slug || r.product === product.name || r.product === product.shortName
);

const totalCount = staticReviews.length;
const avgScore = totalCount > 0
  ? (staticReviews.reduce((acc, r) => acc + r.rating, 0) / totalCount).toFixed(1)
  : '5.0';
---

<section class="section border-t border-line bg-white" id="danh-gia-san-pham" data-product-reviews={product.slug}>
  <div class="container-x">
    <!-- Header mục đánh giá -->
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <span class="eyebrow">Đánh giá sản phẩm</span>
        <h2 class="h-section text-ink">Cảm nhận từ khách hàng</h2>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-1.5 rounded-full bg-cream px-3.5 py-1.5 font-bold text-ink">
            <span class="text-sun flex gap-0.5">
              {[1, 2, 3, 4, 5].map(() => (
                <Icon name="star" class="size-4 fill-current" />
              ))}
            </span>
            <span class="ml-1 text-sm font-extrabold text-brand" data-avg-score>{avgScore}</span>
            <span class="text-xs text-muted">/ 5</span>
          </div>
          <span class="text-sm text-muted">
            <span data-review-count>{totalCount}</span> đánh giá dành cho <strong>{product.shortName}</strong>
          </span>
        </div>
      </div>

      <div>
        <button
          type="button"
          class="btn btn-primary"
          data-toggle-review-form
        >
          <Icon name="star" /> Viết đánh giá
        </button>
      </div>
    </div>

    <!-- Form viết đánh giá (mặc định ẩn, bấm nút sẽ mở ra) -->
    <div
      class="mt-8 hidden overflow-hidden rounded-2xl border-2 border-brand-200 bg-cream/50 p-6 transition-all duration-300 sm:p-8"
      data-review-form-container
    >
      <div class="mb-6 flex items-center justify-between border-b border-line pb-4">
        <div>
          <h3 class="text-lg font-bold text-brand">Gửi đánh giá của bạn</h3>
          <p class="text-sm text-muted">Chia sẻ trải nghiệm sử dụng {product.shortName} với cộng đồng</p>
        </div>
        <button
          type="button"
          class="icon-btn size-9"
          data-close-review-form
          aria-label="Đóng form đánh giá"
        >
          <Icon name="close" class="size-4" />
        </button>
      </div>

      <form class="space-y-5" data-form="product-review" novalidate>
        <input type="hidden" name="productSlug" value={product.slug} />
        <input type="hidden" name="productName" value={product.shortName} />
        <!-- chống bot -->
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <!-- Chọn số sao -->
        <div class="field" data-rating-picker>
          <span class="text-sm font-semibold text-ink">Chất lượng sản phẩm *</span>
          <div class="mt-1 flex flex-wrap items-center gap-3">
            <div class="flex gap-1 text-sun" role="radiogroup" aria-label="Chọn số sao đánh giá">
              {[1, 2, 3, 4, 5].map((n) => (
                <button
                  type="button"
                  class="group p-1 transition-transform hover:scale-125 focus:outline-none"
                  data-star-val={n}
                  aria-label={`${n} sao`}
                >
                  <Icon name="star" class="size-7 fill-current transition-colors" />
                </button>
              ))}
            </div>
            <input type="hidden" name="rating" value="5" data-rating-input />
            <span class="text-sm font-semibold text-brand" data-rating-label>Rất hài lòng (5/5 sao)</span>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field">
            Họ và tên *
            <input
              class="input"
              name="name"
              required
              autocomplete="name"
              placeholder="Nhập tên của bạn (VD: Minh Anh)"
            />
          </label>
          <label class="field">
            Số điện thoại hoặc Email
            <input
              class="input"
              name="contact"
              placeholder="090xxxxxxx hoặc email@domain.com"
            />
          </label>
        </div>

        <label class="field">
          Khu vực / Không gian sử dụng
          <input
            class="input"
            name="place"
            placeholder="VD: Ban công chung cư Cầu Giấy, Sân thượng nhà phố Q7..."
          />
        </label>

        <label class="field">
          Nhận xét chi tiết *
          <textarea
            class="input min-h-28 resize-y"
            name="text"
            required
            rows="3"
            placeholder="Chia sẻ cảm nhận của bạn về khả năng tưới tự động, độ bền, kết nối app hoặc tính tiện lợi..."
          ></textarea>
        </label>

        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
          <button class="btn btn-primary sm:min-w-44" type="submit">
            <Icon name="send" /> Gửi đánh giá
          </button>
          <button class="btn btn-outline" type="button" data-close-review-form>
            Huỷ bỏ
          </button>
          <p class="form-msg" data-review-msg role="status"></p>
        </div>
      </form>
    </div>

    <!-- Danh sách đánh giá -->
    <div class="mt-8" data-reviews-wrap>
      <!-- Khung rỗng nếu chưa có đánh giá nào -->
      <div
        data-empty-reviews
        class:list={[
          'rounded-2xl border border-dashed border-line bg-cream/30 p-10 text-center',
          totalCount > 0 && 'hidden',
        ]}
      >
        <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50 text-brand">
          <Icon name="star" class="size-6 text-sun fill-current" />
        </div>
        <p class="mt-3 text-base font-semibold text-ink">Chưa có đánh giá nào cho sản phẩm này</p>
        <p class="mt-1 text-sm text-muted">Hãy là người đầu tiên chia sẻ cảm nhận trải nghiệm thực tế cùng VIO GREEN.</p>
        <button
          type="button"
          class="btn btn-outline mt-5"
          data-toggle-review-form
        >
          <Icon name="star" /> Viết đánh giá đầu tiên
        </button>
      </div>

      <!-- Danh sách thẻ đánh giá -->
      <div
        class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
        data-reviews-list
      >
        <!-- Vị trí chèn đánh giá người dùng gửi trên trình duyệt -->
        <div class="contents" data-local-reviews-slot></div>

        <!-- Các đánh giá có sẵn từ reviews.ts -->
        {staticReviews.map((r, i) => (
          <figure class="card flex min-w-0 flex-col overflow-hidden p-5 sm:p-6 shadow-soft" data-reveal style={`--d:${(i % 3) * 80}ms`}>
            <div class="flex items-center justify-between gap-2">
              <div class="flex gap-0.5 text-sun" aria-label={`${r.rating}/5 sao`}>
                {[1, 2, 3, 4, 5].map((n) => (
                  <Icon name="star" class:list={['size-4', n <= r.rating ? 'fill-current' : 'opacity-30']} />
                ))}
              </div>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand">
                <Icon name="check" class="size-3.5 text-brand" /> Đã xác thực
              </span>
            </div>

            <blockquote class="mt-4 flex-1 text-ink/90 leading-relaxed break-words">“{r.text}”</blockquote>

            <figcaption class="mt-5 flex min-w-0 items-center gap-3 border-t border-line pt-4">
              {r.photo ? (
                <img src={r.photo} alt="" class="size-11 shrink-0 rounded-full object-cover" loading="lazy" />
              ) : (
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-50 font-bold text-brand">
                  {r.name.trim().split(' ').pop()?.[0]}
                </span>
              )}
              <div class="min-w-0 flex-1 text-sm">
                <p class="font-semibold text-ink">{r.name}</p>
                <p class="truncate text-xs text-muted">
                  {[r.place, r.date].filter(Boolean).join(' · ')}
                </p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>

  <!-- Template cho thẻ đánh giá mới thêm bằng JS -->
  <template id="vg-review-card-tmpl">
    <figure class="card flex min-w-0 flex-col overflow-hidden p-5 sm:p-6 shadow-soft border-brand-300">
      <div class="flex items-center justify-between gap-2">
        <div class="flex gap-0.5 text-sun" data-tmpl-stars aria-label="5/5 sao">
          {[1, 2, 3, 4, 5].map((n) => (
            <span data-star-idx={n} class="inline-flex">
              <Icon name="star" class="size-4 fill-current" />
            </span>
          ))}
        </div>
        <span class="tag bg-brand-50 text-xs font-semibold text-brand">Đánh giá của bạn</span>
      </div>
      <blockquote class="mt-4 flex-1 text-ink/90 leading-relaxed break-words" data-tmpl-text></blockquote>
      <figcaption class="mt-5 flex min-w-0 items-center gap-3 border-t border-line pt-4">
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-50 font-bold text-brand" data-tmpl-avatar></span>
        <div class="min-w-0 flex-1 text-sm">
          <p class="font-semibold text-ink" data-tmpl-name></p>
          <p class="truncate text-xs text-muted" data-tmpl-meta></p>
        </div>
      </figcaption>
    </figure>
  </template>
</section>

<script>
  import { toast } from '../scripts/ui';
  import { submitLead } from '../scripts/forms';

  function initProductReviews() {
    const root = document.querySelector<HTMLElement>('[data-product-reviews]');
    if (!root) return;

    const slug = root.dataset.productReviews || '';
    const STORAGE_KEY = `vg_product_reviews_${slug}`;

    const formContainer = root.querySelector<HTMLElement>('[data-review-form-container]');
    const openBtns = root.querySelectorAll<HTMLButtonElement>('[data-toggle-review-form]');
    const closeBtns = root.querySelectorAll<HTMLButtonElement>('[data-close-review-form]');
    const form = root.querySelector<HTMLFormElement>('form[data-form="product-review"]');
    const emptyBox = root.querySelector<HTMLElement>('[data-empty-reviews]');
    const localSlot = root.querySelector<HTMLElement>('[data-local-reviews-slot]');
    const tmpl = root.querySelector<HTMLTemplateElement>('#vg-review-card-tmpl');
    const msg = root.querySelector<HTMLElement>('[data-review-msg]');
    const countEl = root.querySelector<HTMLElement>('[data-review-count]');

    // Toggle form
    const toggleForm = (show?: boolean) => {
      if (!formContainer) return;
      const isHidden = formContainer.classList.contains('hidden');
      const next = typeof show === 'boolean' ? show : isHidden;
      formContainer.classList.toggle('hidden', !next);
      if (next) {
        formContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        (form?.elements.namedItem('name') as HTMLInputElement | null)?.focus();
      }
    };

    openBtns.forEach((b) => b.addEventListener('click', () => toggleForm(true)));
    closeBtns.forEach((b) => b.addEventListener('click', () => toggleForm(false)));

    // Interactive Star Picker
    const ratingPicker = root.querySelector<HTMLElement>('[data-rating-picker]');
    const ratingInput = root.querySelector<HTMLInputElement>('[data-rating-input]');
    const ratingLabel = root.querySelector<HTMLElement>('[data-rating-label]');
    const starBtns = ratingPicker?.querySelectorAll<HTMLButtonElement>('[data-star-val]');

    const LABELS: Record<number, string> = {
      5: 'Rất hài lòng (5/5 sao)',
      4: 'Hài lòng (4/5 sao)',
      3: 'Bình thường (3/5 sao)',
      2: 'Chưa hài lòng (2/5 sao)',
      1: 'Rất không hài lòng (1/5 sao)',
    };

    const updateStarsUI = (val: number) => {
      if (!starBtns || !ratingInput || !ratingLabel) return;
      ratingInput.value = String(val);
      ratingLabel.textContent = LABELS[val] || `${val}/5 sao`;

      starBtns.forEach((btn) => {
        const btnVal = Number(btn.dataset.starVal);
        const svg = btn.querySelector('svg');
        if (!svg) return;
        if (btnVal <= val) {
          svg.classList.add('fill-current');
          svg.classList.remove('opacity-30');
        } else {
          svg.classList.remove('fill-current');
          svg.classList.add('opacity-30');
        }
      });
    };

    starBtns?.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = Number(btn.dataset.starVal) || 5;
        updateStarsUI(val);
      });
    });

    // Render review card from template
    interface LocalReview {
      name: string;
      place?: string;
      rating: number;
      text: string;
      date: string;
    }

    const renderCard = (data: LocalReview) => {
      if (!tmpl || !localSlot) return;
      const clone = tmpl.content.cloneNode(true) as HTMLElement;

      const stars = clone.querySelectorAll<HTMLElement>('[data-star-idx]');
      stars.forEach((s) => {
        const idx = Number(s.dataset.starIdx);
        const svg = s.querySelector('svg');
        if (svg && idx > data.rating) {
          svg.classList.remove('fill-current');
          svg.classList.add('opacity-30');
        }
      });

      const textEl = clone.querySelector('[data-tmpl-text]');
      if (textEl) textEl.textContent = `“${data.text}”`;

      const avatarEl = clone.querySelector('[data-tmpl-avatar]');
      if (avatarEl) avatarEl.textContent = data.name.trim().split(' ').pop()?.[0] || 'K';

      const nameEl = clone.querySelector('[data-tmpl-name]');
      if (nameEl) nameEl.textContent = data.name;

      const metaEl = clone.querySelector('[data-tmpl-meta]');
      if (metaEl) metaEl.textContent = [data.place, data.date].filter(Boolean).join(' · ');

      localSlot.prepend(clone);
    };

    // Load saved reviews from localStorage
    const loadStoredReviews = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const list: LocalReview[] = JSON.parse(raw);
        if (Array.isArray(list) && list.length > 0) {
          list.forEach((item) => renderCard(item));
          emptyBox?.classList.add('hidden');
          if (countEl) {
            const current = Number(countEl.textContent) || 0;
            countEl.textContent = String(current + list.length);
          }
        }
      } catch {
        /* ignore */
      }
    };

    loadStoredReviews();

    // Form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if ((form.elements.namedItem('website') as HTMLInputElement | null)?.value) return; // bot

      const nameInput = form.elements.namedItem('name') as HTMLInputElement | null;
      const textInput = form.elements.namedItem('text') as HTMLTextAreaElement | null;
      const contactInput = form.elements.namedItem('contact') as HTMLInputElement | null;
      const placeInput = form.elements.namedItem('place') as HTMLInputElement | null;
      const productName = (form.elements.namedItem('productName') as HTMLInputElement | null)?.value || slug;

      const name = nameInput?.value.trim() || '';
      const text = textInput?.value.trim() || '';
      const contact = contactInput?.value.trim() || '';
      const place = placeInput?.value.trim() || '';
      const rating = Number(ratingInput?.value) || 5;

      if (!name) {
        if (msg) { msg.textContent = 'Vui lòng nhập họ và tên của bạn.'; msg.dataset.state = 'error'; }
        nameInput?.focus();
        return;
      }

      if (!text || text.length < 5) {
        if (msg) { msg.textContent = 'Vui lòng viết ít nhất vài từ cảm nhận của bạn.'; msg.dataset.state = 'error'; }
        textInput?.focus();
        return;
      }

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const oldHtml = submitBtn?.innerHTML || '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang gửi…';
      }

      const today = new Date().toISOString().slice(0, 10);
      const newReview: LocalReview = {
        name,
        place,
        rating,
        text,
        date: today,
      };

      // 1. Lưu localStorage
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const list: LocalReview[] = raw ? JSON.parse(raw) : [];
        list.unshift(newReview);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch {
        /* ignore */
      }

      // 2. Gửi lead để lưu vào Firestore (nếu có kết nối Firebase)
      try {
        await submitLead('contact', {
          source: 'product-review',
          name,
          phone: contact,
          message: `[Đánh giá ${rating} sao cho ${productName} - ${place || 'Không ghi địa chỉ'}]: ${text}`,
          topic: `Đánh giá sản phẩm ${productName}`,
        });
      } catch (err) {
        console.error(err);
      }

      // 3. Render ngay lên giao diện
      renderCard(newReview);
      emptyBox?.classList.add('hidden');
      if (countEl) {
        const current = Number(countEl.textContent) || 0;
        countEl.textContent = String(current + 1);
      }

      // 4. Reset & Đóng form
      form.reset();
      updateStarsUI(5);
      toggleForm(false);
      toast('Cảm ơn bạn! Đánh giá của bạn đã được gửi thành công.');

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = oldHtml;
      }
    });
  }

  // Khởi tạo khi load trang hoặc điều hướng
  initProductReviews();
  document.addEventListener('astro:page-load', initProductReviews);
</script>
