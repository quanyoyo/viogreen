---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import PolicyStrip from '../../components/PolicyStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { products, inCategory, categories, plantLabels, powerLabels, waterLabels, type CategoryKey } from '../../data/products';

const filters = [
  ['plants', 'Số lượng cây', plantLabels],
  ['power', 'Nguồn điện', powerLabels],
  ['water', 'Nguồn nước', waterLabels],
] as const;

const sections: { key: CategoryKey; title: string; sub: string; cols: string; tint: boolean }[] = [
  { key: 'ecobox', title: 'Bình chứa ECOBOX', sub: 'Bình chứa dinh dưỡng (Bio-Tank) và nước (Aqua-Tank) – thay thế hoặc bổ sung theo cấu hình S / Plus / Pro.', cols: 'sm:grid-cols-2 lg:grid-cols-3', tint: true },
  { key: 'irrigation', title: 'Phụ kiện tưới', sub: 'Đầu tưới nhỏ giọt và ống dẫn để đưa nước, dinh dưỡng đến từng gốc cây.', cols: 'sm:grid-cols-2 lg:max-w-4xl lg:mx-auto', tint: false },
];
const nutriInfo = [
  ['settings', 'Công dụng', 'Bổ sung dinh dưỡng cho cây trong hệ thống ECOHUB theo cấu hình phù hợp.'],
  ['product', 'Quy cách', 'Gói lẻ 25g hoặc hộp Multi-Pack nhiều gói để dự trữ cho nhiều chu kỳ.'],
  ['science', 'Hướng dẫn', 'Liều lượng, cách pha/trộn và tần suất theo hướng dẫn chính thức của VIO GREEN.'],
  ['warning', 'Lưu ý', 'Không tự ý tăng liều lượng khi chưa có hướng dẫn kỹ thuật.'],
] as const;
---
<BaseLayout title="Sản phẩm" active="products"
  description="Hệ thống chăm sóc cây thông minh ECOHUB Sol, Grid, Plus, Pro, bình chứa ECOBOX, phụ kiện tưới và phân bón Bio-Nutri.">
  <Breadcrumbs items={[['Sản phẩm']]} />

  <!-- HERO: ảnh banner (nửa phải mờ trắng) – chữ đặt bên phải -->
  <section class="relative isolate overflow-hidden bg-white">
    <div class="relative aspect-[16/9] lg:absolute lg:inset-0 lg:aspect-auto">
      <img src="/assets/banner-san-pham.webp" srcset="/assets/banner-san-pham-800.webp 800w, /assets/banner-san-pham.webp 1680w" sizes="100vw"
        alt="Máy VIO GREEN ECOHUB bên các luống rau trên sân thượng" class="size-full animate-breath object-cover object-left" fetchpriority="high" />
      <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(to_top,white,transparent_35%)] lg:bg-[linear-gradient(to_left,rgb(255_255_255/.96)_0%,rgb(255_255_255/.9)_40%,rgb(255_255_255/.55)_52%,transparent_68%)]"></div>
    </div>
    <div class="container-x relative grid lg:min-h-[480px] lg:grid-cols-[1.35fr_1fr] lg:items-center">
      <div class="-mt-6 pb-12 lg:col-start-2 lg:mt-0 lg:py-16" data-reveal>
        <p class="eyebrow">Sản phẩm VIO GREEN</p>
        <h1 class="h-display">ECOHUB – Thiết bị chăm sóc cây thông minh.</h1>
        <p class="mt-4 text-lg text-muted">Hệ thống chăm sóc cây trồng đô thị thông minh tích hợp toàn diện các công nghệ tiên tiến.</p>
        <nav aria-label="Nhóm sản phẩm" class="mt-6 flex flex-wrap gap-2">
          {categories.map((c) => <a class="chip" href={`#${c.key}`}>{c.short}</a>)}
        </nav>
      </div>
    </div>
  </section>

  <!-- Kết quả tìm kiếm (hiện khi có ?q=) -->
  <section class="section bg-white" data-search-results hidden>
    <div class="container-x">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Tìm kiếm</p>
          <h2 class="h-section">Kết quả cho “<span data-search-term></span>”</h2>
          <p class="mt-1 text-sm text-muted" data-search-count></p>
        </div>
        <a class="link-arrow" href="/san-pham/">Xóa tìm kiếm <Icon name="close" /></a>
      </div>
      <p class="rounded-2xl bg-cream p-6 text-muted" data-search-empty hidden>
        Không tìm thấy sản phẩm phù hợp. Thử từ khóa khác như “ECOHUB”, “Bio-Tank”, “Hose” hoặc <button type="button" class="font-semibold text-brand underline" data-open-chat>hỏi MIO</button> nhé.
      </p>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-search-grid>
        {products.map((p) => <ProductCard p={p} reveal={false} />)}
      </div>
    </div>
  </section>

  <div data-catalog>
    <!-- ECOHUB + bộ lọc -->
    <section class="section scroll-mt-28" id="ecohub">
      <div class="container-x">
        <SectionHead eyebrow="Hệ thống ECOHUB" title="Chọn ECOHUB phù hợp không gian của bạn" sub="6 phiên bản theo số lượng cây, nguồn điện và nguồn nước. Tất cả đều xem được bằng AR." />
        <div class="card mb-8 grid gap-4 p-5 sm:p-6 lg:grid-cols-3" data-filters data-reveal>
          {filters.map(([name, label, map]) => (
            <div role="group" aria-label={label}>
              <p class="mb-2 text-xs font-bold tracking-[0.16em] text-muted uppercase">{label}</p>
              <div class="flex flex-wrap gap-2">
                <button type="button" class="chip" aria-pressed="true" data-filter={name} data-value="">Tất cả</button>
                {Object.entries(map).map(([v, l]) => <button type="button" class="chip" aria-pressed="false" data-filter={name} data-value={v}>{l}</button>)}
              </div>
            </div>
          ))}
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-filter-grid>
          {inCategory('ecohub').map((p, i) => <ProductCard p={p} delay={(i % 3) * 80} />)}
        </div>
        <p class="mt-6 rounded-2xl bg-cream p-6 text-center text-muted" data-filter-empty hidden>
          Chưa có phiên bản khớp với lựa chọn này.
          <button type="button" class="font-semibold text-brand underline" data-filter-reset>Xóa bộ lọc</button> hoặc
          <button type="button" class="font-semibold text-brand underline" data-open-chat>hỏi MIO</button>.
        </p>
      </div>
    </section>

    {sections.map((s) => (
      <section class:list={['section scroll-mt-28', s.tint && 'bg-cream']} id={s.key}>
        <div class="container-x">
          <SectionHead eyebrow={categories.find((c) => c.key === s.key)!.label} title={s.title} sub={s.sub} />
          <div class:list={['grid gap-6', s.cols]}>{inCategory(s.key).map((p, i) => <ProductCard p={p} delay={i * 70} />)}</div>
        </div>
      </section>
    ))}

    <!-- Dinh dưỡng -->
    <section class="section scroll-mt-28 bg-brand text-white" id="nutrition">
      <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center">
        <div data-reveal>
          <p class="eyebrow eyebrow-light">Dinh dưỡng Bio-Nutri</p>
          <h2 class="h-section">Gói phân bón VIO GREEN</h2>
          <p class="mt-4 text-brand-100">Phân bón sinh học dạng gói được thiết kế để bổ sung dinh dưỡng cho cây trong hệ thống chăm sóc VIO GREEN – dễ bảo quản, dễ sử dụng theo từng chu kỳ.</p>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {nutriInfo.map(([ic, t, d]) => (
              <div class="flex gap-3 rounded-2xl bg-white/[0.07] p-4 ring-1 ring-white/10">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-white/15"><Icon name={ic} class="size-5" /></span>
                <div><h3 class="font-semibold">{t}</h3><p class="mt-1 text-sm text-brand-100">{d}</p></div>
              </div>
            ))}
          </div>
        </div>
        <div class="grid gap-6 text-ink sm:grid-cols-2">{inCategory('nutrition').map((p, i) => <ProductCard p={p} delay={i * 80} />)}</div>
      </div>
    </section>
  </div>

  <PolicyStrip />
  <CtaBand />
</BaseLayout>

<script>
  // Bộ lọc ECOHUB + tìm kiếm ?q=
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/[^a-z0-9]+/g, ' ').trim();

  const state: Record<string, string> = { plants: '', power: '', water: '' };
  const grid = document.querySelector<HTMLElement>('[data-filter-grid]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const applyFilters = () => {
    let shown = 0;
    grid?.querySelectorAll<HTMLElement>('[data-product]').forEach((card) => {
      const ok = Object.entries(state).every(([k, v]) => !v || card.dataset[k] === v);
      card.hidden = !ok;
      if (ok) { shown++; card.classList.add('is-visible'); }
    });
    if (empty) empty.hidden = shown > 0;
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
      b.setAttribute('aria-pressed', String(state[b.dataset.filter!] === b.dataset.value));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
    b.addEventListener('click', () => { state[b.dataset.filter!] = b.dataset.value!; applyFilters(); }));
  document.querySelector('[data-filter-reset]')?.addEventListener('click', () => {
    Object.keys(state).forEach((k) => (state[k] = '')); applyFilters();
  });

  // Tìm kiếm: mọi từ khóa (không dấu) phải có trong tên/mô tả
  const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
  if (q) {
    const terms = norm(q).split(' ').filter(Boolean);
    const box = document.querySelector<HTMLElement>('[data-search-results]')!;
    let n = 0;
    box.querySelectorAll<HTMLElement>('[data-product]').forEach((card) => {
      const hay = norm(card.dataset.search ?? '');
      const ok = terms.every((t) => ` ${hay}`.includes(` ${t}`)); // khớp đầu từ: “ong” không khớp “không”
      card.hidden = !ok;
      if (ok) n++;
    });
    box.hidden = false;
    box.querySelector('[data-search-term]')!.textContent = q;
    box.querySelector('[data-search-count]')!.textContent = n ? `Tìm thấy ${n} sản phẩm` : '';
    (box.querySelector('[data-search-empty]') as HTMLElement).hidden = n > 0;
    document.querySelectorAll<HTMLInputElement>('input[name="q"]').forEach((i) => (i.value = q));
    document.title = `Tìm “${q}” | VIO GREEN`;
    requestAnimationFrame(() => box.scrollIntoView({ block: 'start' }));
  }
</script>
