---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Ph from '../../components/Ph.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import PolicyStrip from '../../components/PolicyStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { products, bySlug, categoryOf, productTags, plantLabels, powerLabels, waterLabels, variantPrice, vnd, smallImage, type Product } from '../../data/products';
import { site, telHref } from '../../data/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const cat = categoryOf(p);
const tags = productTags(p);

// Ảnh: khung ảnh (p.images) + ảnh có chữ trong phần mô tả (p.info) – tất cả mở được trong khung phóng to
const zoomList = [...p.images, ...(p.info ?? [])];
const srcset = (src: string) => (smallImage(src) !== src ? `${smallImage(src)} 800w, ${src} 1600w` : undefined);

// Giá theo lựa chọn đang chọn (mặc định lựa chọn đầu tiên)
const firstPrice = variantPrice(p, p.variants?.options[0]);
const knownPrices = (p.variants?.prices ?? [p.price]).filter((x): x is number => x != null);

// ECOHUB → link ECOBOX chọn sẵn đúng dòng máy (?may=s|plus|pro)
const tier = p.slug.endsWith('-pro') ? 'pro' : p.slug.endsWith('-plus') ? 'plus' : 's';
const accHref = (a: Product) => `/san-pham/${a.slug}/` + (p.category === 'ecohub' && a.variants?.pick ? `?may=${tier}` : '');

const specs: [string, string][] = [];
if (p.category === 'ecohub' && p.plants && p.power && p.water) {
  specs.push(['Số lượng cây phù hợp', plantLabels[p.plants]], ['Nguồn điện', powerLabels[p.power]], ['Chế độ cấp nước', waterLabels[p.water]], ['Phiên bản', p.edition ?? ''],
    ['Bảo hành', '12 tháng (có gói 18 và 24 tháng)']);
}
if (p.fits) specs.push(['Tương thích', p.fits]);
specs.push(...p.specs);

const acc = p.accessories.map((s) => bySlug[s]).filter(Boolean);
const related = p.category === 'ecobox'
  ? { title: 'Dùng cho các dòng máy ECOHUB', items: acc }
  : acc.length >= 3
    ? { title: 'Phụ kiện tương thích', items: acc.slice(0, 4) }
    : { title: 'Sản phẩm liên quan', items: [...acc, ...products.filter((x) => x.category === p.category && x.slug !== p.slug)].slice(0, 3) };
const relCols = related.items.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.description[0],
  brand: { '@type': 'Brand', name: 'VIO GREEN' },
  category: cat.label,
  ...(p.images.length ? { image: p.images.map((src) => new URL(src, Astro.site).href) } : {}),
  ...(knownPrices.length === 0 ? {}
    : p.variants?.prices
      ? { offers: { '@type': 'AggregateOffer', priceCurrency: 'VND', lowPrice: Math.min(...knownPrices), highPrice: Math.max(...knownPrices), offerCount: knownPrices.length, availability: 'https://schema.org/InStock' } }
      : { offers: { '@type': 'Offer', priceCurrency: 'VND', price: p.price, availability: 'https://schema.org/InStock' } }),
};
---
<BaseLayout title={p.shortName} description={p.summary} active="products" jsonLd={jsonLd}>
  <Breadcrumbs items={[['Sản phẩm', '/san-pham/'], [cat.short, `/san-pham/#${cat.key}`], [p.shortName]]} />

  <section class="py-10 sm:py-14">
    <div class="container-x grid gap-10 lg:grid-cols-2 lg:gap-14" data-pdp={p.slug}>
      <!-- Ảnh: bấm để phóng to (khung xem ảnh ở cuối trang) -->
      <div data-reveal data-gallery>
        <div class="relative overflow-hidden rounded-card border border-brand-200 bg-white">
          {p.images[0] ? (
            <button type="button" class="group block w-full cursor-zoom-in" data-zoom-open="0" data-gallery-main aria-label="Phóng to ảnh sản phẩm">
              <img src={smallImage(p.images[0])} srcset={srcset(p.images[0])} sizes="(min-width: 1024px) 560px, 100vw" alt={p.name} width="1600" height="1600"
                class="aspect-square w-full object-contain p-4 transition-transform duration-500 group-hover:scale-[1.03] sm:p-6" fetchpriority="high" data-gallery-img />
            </button>
          ) : <Ph title={p.shortName} ratio="1/1" label="Ảnh sản phẩm đang cập nhật" />}
          {p.images[0] && (
            <span class="pointer-events-none absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1.5 text-xs font-semibold text-brand shadow-soft">
              <Icon name="zoomIn" class="size-4" /> Bấm để phóng to
            </span>
          )}
          {p.hasAR && (
            <button type="button" data-ar={p.slug} class="btn btn-light absolute bottom-4 left-4 min-h-11 px-4 py-2"><Icon name="ar" /> Thử với AR</button>
          )}
        </div>
        {p.images.length > 1 && (
          <ul class="mt-3 grid grid-cols-4 gap-3" aria-label="Ảnh sản phẩm">
            {p.images.map((src, i) => (
              <li>
                <button type="button" data-thumb={i} data-src={smallImage(src)} data-srcset={srcset(src)} aria-current={i === 0 ? 'true' : 'false'} aria-label={`Xem ảnh ${i + 1}`}
                  class="block w-full overflow-hidden rounded-2xl border-2 border-line bg-white transition-colors hover:border-brand-300 aria-[current=true]:border-brand">
                  <img src={smallImage(src)} alt="" loading="lazy" width="800" height="800" class="aspect-square w-full object-contain p-1.5" />
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Thông tin mua -->
      <div data-reveal style="--d:100ms">
        <p class="text-xs font-semibold tracking-[0.16em] text-brand-500 uppercase">{cat.label}</p>
        <h1 class="mt-2 text-2xl leading-tight font-extrabold sm:text-3xl">{p.name}</h1>
        <p class="mt-3 text-muted sm:text-lg">{p.summary}</p>
        {tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2">{tags.map((t) => <li class="tag px-3 py-1.5 text-sm">{t}</li>)}</ul>}

        <div class="mt-6 rounded-2xl bg-cream p-5" data-price-box data-prices={p.variants?.prices ? JSON.stringify(p.variants.prices) : undefined} data-fallback={site.priceFallback}>
          <p class:list={['text-2xl font-extrabold', firstPrice ? 'text-ink' : 'text-brand']} data-price-text>{p.gift ? 'Hàng tặng – không bán' : firstPrice ? vnd(firstPrice) : site.priceFallback}</p>
          <p class="mt-1 text-sm text-muted" data-price-note hidden={!!firstPrice || !!p.gift}>Nhân viên sẽ báo giá khi xác nhận đơn</p>
          {p.gift && <p class="mt-1 text-sm text-muted">Sản phẩm tặng kèm, không bán riêng.</p>}
        </div>

        <dl class="mt-6 space-y-5">
          {p.variants && (
            <div>
              <dt class="mb-2 text-sm font-semibold">{p.variants.label}</dt>
              <dd class="flex flex-wrap gap-2" role="radiogroup" aria-label={p.variants.label}>
                {p.variants.options.map((o, i) => <button type="button" class="chip" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-variant={o}>{o}</button>)}
              </dd>
              {p.variants.hint && <dd class="mt-2 text-xs text-muted">{p.variants.hint}</dd>}
            </div>
          )}
          {!p.gift && <div>
            <dt class="mb-2 text-sm font-semibold">Số lượng</dt>
            <dd>
              <div class="inline-flex items-center rounded-full border border-line" data-qty>
                <button type="button" aria-label="Giảm" data-qty-minus class="inline-flex size-11 items-center justify-center rounded-full hover:bg-brand-50"><Icon name="minus" class="size-4" /></button>
                <input type="number" value="1" min="1" max="99" aria-label="Số lượng" data-qty-input class="w-12 appearance-none bg-transparent text-center font-semibold outline-none [&::-webkit-inner-spin-button]:appearance-none" />
                <button type="button" aria-label="Tăng" data-qty-plus class="inline-flex size-11 items-center justify-center rounded-full hover:bg-brand-50"><Icon name="plus" class="size-4" /></button>
              </div>
            </dd>
          </div>}
          {!p.gift && <div class="flex items-start gap-2 text-sm text-muted"><Icon name="truck" class="mt-0.5 size-4 shrink-0 text-brand" /> Giao hàng toàn quốc – phí vận chuyển được thông báo khi xác nhận đơn</div>}
        </dl>

        {!p.gift && <div class="mt-7 grid gap-3 sm:grid-cols-2">
          <button class="btn btn-dark" type="button" data-add-cart={p.slug} data-with-qty><Icon name="cart" /> Thêm vào giỏ hàng</button>
          <button class="btn btn-accent" type="button" data-buy-now={p.slug}>Mua ngay</button>
        </div>}
        <p class="mt-5 flex flex-wrap items-center gap-1.5 text-sm text-muted">
          <Icon name="help" class="size-4 text-brand" /> Cần tư vấn chọn cấu hình?
          <button type="button" class="font-semibold text-brand underline" data-open-chat>Hỏi MIO</button> hoặc gọi
          <a href={telHref} class="font-semibold text-brand">{site.phone}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container-x grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div data-reveal>
        <h2 class="flex items-center gap-2 text-xl font-bold text-brand sm:text-2xl"><Icon name="info" class="size-6" /> Mô tả chi tiết sản phẩm</h2>
        <div class="mt-5 space-y-4 leading-7 text-ink/90">{p.description.map((d) => <p>{d}</p>)}</div>
        {p.highlights && (
          <div class="mt-7">
            <h3 class="font-bold text-brand">{p.highlights.title}</h3>
            <ul class="mt-3 space-y-2.5">
              {p.highlights.items.map((t) => <li class="flex gap-2.5 leading-relaxed text-ink/90"><Icon name="check" class="mt-1 size-4 shrink-0 text-brand" />{t}</li>)}
            </ul>
          </div>
        )}
        {p.info?.map((src, j) => (
          <button type="button" data-zoom-open={p.images.length + j} aria-label="Phóng to ảnh thông tin sản phẩm"
            class="mt-7 block w-full max-w-xl cursor-zoom-in overflow-hidden rounded-card border border-line bg-white shadow-soft">
            <img src={smallImage(src)} srcset={srcset(src)} sizes="(min-width: 640px) 576px, 100vw" alt={`${p.shortName} – thông tin sản phẩm`}
              loading="lazy" width="1600" height="1600" class="w-full" />
          </button>
        ))}
        {p.note && (
          <div class="mt-6 flex gap-3 rounded-2xl border border-sun/50 bg-sun/10 p-4 text-sm">
            <Icon name="warning" class="mt-0.5 size-5 shrink-0 text-[#a37813]" />
            <p><strong>Lưu ý:</strong> {p.note}</p>
          </div>
        )}
      </div>
      <aside class="card h-fit space-y-6 p-6" data-reveal style="--d:100ms">
        <div>
          <h3 class="font-bold">Thông tin sản phẩm</h3>
          <dl class="mt-3 divide-y divide-line text-sm">
            {specs.map(([k, v]) => <div class="flex justify-between gap-4 py-2.5"><dt class="text-muted">{k}</dt><dd class="text-right font-medium">{v}</dd></div>)}
          </dl>
        </div>
        {acc.length > 0 && (
          <div>
            <h3 class="font-bold">{p.category === 'ecobox' ? 'Dùng cho máy' : 'Phụ kiện tương thích'}</h3>
            <ul class="mt-3 space-y-2">
              {acc.map((a) => <li><a href={accHref(a)} class="flex items-center gap-2 rounded-xl px-2 py-1.5 text-sm font-medium text-brand hover:bg-brand-50"><Icon name="box" class="size-4" /> {a.shortName}</a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHead title={related.title} />
      <div class:list={['grid gap-6', relCols]}>{related.items.map((x, i) => <ProductCard p={x} delay={i * 70} />)}</div>
    </div>
  </section>

  <PolicyStrip />
  <CtaBand />

  <!-- Khung xem ảnh phóng to: nút +/−, cuộn chuột, chạm 2 ngón, nhấp đúp; kéo để xem chỗ khác -->
  {zoomList.length > 0 && (
    <div class="fixed inset-0 z-[70] bg-ink/95 opacity-0 transition-opacity duration-300 data-[open]:opacity-100" hidden data-lightbox
      role="dialog" aria-modal="true" aria-label={`Ảnh ${p.shortName}`} data-images={JSON.stringify(zoomList)}>
      <div class="absolute inset-0 cursor-grab touch-none overflow-hidden select-none" data-lb-stage>
        <img alt={p.name} draggable="false" class="absolute top-1/2 left-1/2 max-h-[84vh] max-w-[94vw] origin-center rounded-xl bg-white will-change-transform" data-lb-img />
      </div>
      <div class="absolute inset-x-0 top-0 flex items-center justify-between gap-3 bg-gradient-to-b from-ink/80 to-transparent p-3 text-white sm:p-4">
        <span class="text-sm font-semibold" data-lb-count aria-live="polite"></span>
        <div class="flex items-center gap-2">
          <button type="button" class="inline-flex size-11 items-center justify-center rounded-full bg-white/15 hover:bg-white/25" data-lb-zoom="-1" aria-label="Thu nhỏ"><Icon name="zoomOut" class="size-5" /></button>
          <span class="w-12 text-center text-sm tabular-nums" data-lb-level>100%</span>
          <button type="button" class="inline-flex size-11 items-center justify-center rounded-full bg-white/15 hover:bg-white/25" data-lb-zoom="1" aria-label="Phóng to"><Icon name="zoomIn" class="size-5" /></button>
          <button type="button" class="ml-2 inline-flex size-11 items-center justify-center rounded-full bg-white text-ink hover:bg-brand-50" data-lb-close aria-label="Đóng"><Icon name="close" class="size-5" /></button>
        </div>
      </div>
      {zoomList.length > 1 && (
        <>
          <button type="button" class="absolute top-1/2 left-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 sm:left-4" data-lb-step="-1" aria-label="Ảnh trước"><Icon name="chevronLeft" class="size-6" /></button>
          <button type="button" class="absolute top-1/2 right-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 sm:right-4" data-lb-step="1" aria-label="Ảnh sau"><Icon name="chevronRight" class="size-6" /></button>
        </>
      )}
    </div>
  )}
</BaseLayout>

<script>
  import '../../scripts/product-page';
</script>
