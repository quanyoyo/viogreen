---
import Icon from './Icon.astro';
---
<div class="fixed inset-0 z-[60] flex items-end justify-center p-0 sm:items-center sm:p-6" data-ar-modal hidden>
  <div class="absolute inset-0 bg-ink/60" data-ar-close></div>
  <div class="relative w-full max-w-3xl rounded-t-3xl bg-white p-5 shadow-2xl sm:rounded-3xl sm:p-7" role="dialog" aria-modal="true" aria-labelledby="ar-title">
    <button class="icon-btn absolute top-4 right-4 z-10" type="button" aria-label="Đóng" data-ar-close><Icon name="close" /></button>
    <p class="eyebrow">Trải nghiệm AR</p>
    <h2 id="ar-title" class="pr-12 text-xl font-bold sm:text-2xl" data-ar-title>ECOHUB</h2>
    <div class="mt-4 overflow-hidden rounded-2xl bg-cream" data-ar-stage></div>
    <p class="mt-3 text-sm text-muted" data-ar-hint></p>
  </div>
</div>
