---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Ph from '../../components/Ph.astro';
import Social from '../../components/Social.astro';
import ContactForm from '../../components/ContactForm.astro';
import PolicyStrip from '../../components/PolicyStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site, telHref } from '../../data/site';
const info = [
  ['phone', 'Hotline tư vấn', site.phone, telHref],
  ['email', 'Hộp thư điện tử', site.email, `mailto:${site.email}`],
  ['pin', 'Trụ sở & Showroom', site.address, `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`],
  ['clock', 'Giờ làm việc', site.hours, ''],
  ...(site.website ? [['globe', 'Website chính thức', site.website, site.website]] : []),
] as [string, string, string, string][];
---
<BaseLayout title="Liên hệ" active="contact" description="Liên hệ VIO GREEN để được tư vấn giải pháp chăm sóc cây thông minh ECOHUB cho ban công, sân thượng, văn phòng.">
  <Breadcrumbs items={[['Liên hệ']]} />

  <!-- Băng ảnh -->
  <section class="overflow-hidden pt-10 sm:pt-14" aria-hidden="true">
    <div class="container-x grid grid-cols-[0.7fr_1.4fr_0.7fr] items-center gap-4">
      <div class="overflow-hidden rounded-3xl opacity-70"><Ph ratio="4/3" label="" /></div>
      <div class="breath shadow-lift"><Ph title="Let's Grow Green Together" ratio="16/10" label="Ảnh không gian xanh đang cập nhật" /></div>
      <div class="overflow-hidden rounded-3xl opacity-70"><Ph ratio="4/3" label="" /></div>
    </div>
  </section>

  <section class="section pt-12 sm:pt-16">
    <div class="container-x">
      <div class="mx-auto mb-12 max-w-3xl text-center" data-reveal>
        <h1 class="h-display">Let's Grow Green Together</h1>
        <p class="mt-4 text-lg text-muted">Bạn đã sẵn sàng mang thiên nhiên xanh mát vào không gian sống của mình? Hãy để lại thông tin, đội ngũ chuyên gia VIO GREEN sẽ đồng hành cùng bạn hiện thực hóa khu vườn mơ ước.</p>
      </div>

      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-12">
        <div class="space-y-5" data-reveal>
          <div class="card p-7 shadow-soft sm:p-8">
            <h2 class="text-2xl font-bold text-brand">Thông tin liên hệ</h2>
            <p class="mt-2 text-sm text-muted">Chúng tôi luôn sẵn sàng lắng nghe và tư vấn giải pháp xanh phù hợp nhất cho không gian của bạn.</p>
            <ul class="mt-6 space-y-5">
              {info.map(([ic, label, value, href]) => (
                <li class="flex gap-4">
                  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-brand text-white"><Icon name={ic as any} class="size-5" /></span>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold">{label}</p>
                    {href ? <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="break-words text-muted hover:text-brand">{value}</a> : <p class="text-muted">{value}</p>}
                  </div>
                </li>
              ))}
            </ul>
            <p class="mt-7 mb-3 text-sm font-semibold text-brand">Kết nối mạng xã hội</p>
            <Social />
          </div>
          <div class="flex items-center gap-4 rounded-card bg-brand p-6 text-white shadow-lift">
            <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-white/15"><Icon name="globe" class="size-6" /></span>
            <div><p class="font-bold">Cam kết xanh 100%</p><p class="text-sm text-brand-100">Mỗi sản phẩm VIO GREEN đều hướng tới sự phát triển bền vững và giảm thiểu dấu chân carbon cho đô thị.</p></div>
          </div>
        </div>

        <div class="card p-6 sm:p-8" data-reveal style="--d:120ms">
          <h2 class="mb-6 text-xl font-bold">Gửi yêu cầu tư vấn</h2>
          <ContactForm source="Trang Liên hệ" />
        </div>
      </div>
    </div>
  </section>

  <PolicyStrip />
  <CtaBand />
</BaseLayout>
