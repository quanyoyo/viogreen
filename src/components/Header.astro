---
import { nav, site, telHref } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
interface Props { active?: string }
const { active = '' } = Astro.props;
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85" data-header>
  <!-- Thanh trên: logo, tìm kiếm, hỗ trợ, giỏ hàng -->
  <div class="border-b border-line/60 transition-[padding] duration-300" data-topbar>
    <div class="container-x flex items-center gap-3 py-2 sm:gap-6">
      <Logo />
      <form action="/san-pham/" method="get" role="search" class="mx-auto hidden w-full max-w-xl items-center overflow-hidden rounded-full border border-line bg-white pl-4 transition-colors focus-within:border-brand md:flex">
        <Icon name="search" class="size-5 shrink-0 text-muted" />
        <input type="search" name="q" placeholder="Tìm sản phẩm: ECOHUB, Bio-Tank, Hose…" aria-label="Tìm sản phẩm" class="min-h-11 w-full bg-transparent px-3 text-sm outline-none" />
        <button type="submit" class="min-h-11 shrink-0 rounded-full bg-brand px-6 text-sm font-semibold text-white transition-colors hover:bg-brand-700">Tìm kiếm</button>
      </form>
      <div class="ml-auto flex items-center gap-2 md:ml-0">
        <button type="button" data-open-chat class="hidden min-h-11 items-center gap-2 rounded-full border border-line px-4 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand lg:inline-flex">
          Hỗ trợ <Icon name="help" class="size-5 text-brand" />
        </button>
        <a href="/tai-khoan/" class="icon-btn" aria-label="Tài khoản" title="Tài khoản"><Icon name="user" /></a>
        <a href="/gio-hang/" class="icon-btn" aria-label="Giỏ hàng">
          <Icon name="cart" />
          <span data-cart-count hidden class="absolute -top-1 -right-1 inline-flex min-w-5 items-center justify-center rounded-full bg-sun px-1 text-[11px] leading-5 font-bold text-ink">0</span>
        </a>
        <button type="button" class="icon-btn lg:hidden" aria-label="Mở menu" aria-expanded="false" aria-controls="drawer" data-menu-open><Icon name="menu" /></button>
      </div>
    </div>
  </div>

  <!-- Thanh menu xanh (desktop) -->
  <nav aria-label="Điều hướng chính" class="hidden bg-brand lg:block">
    <div class="container-x flex items-stretch justify-between">
      <ul class="flex items-stretch">
        {nav.map((n) => (
          <li class="flex">
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
              class:list={['relative flex items-center px-6 py-3.5 text-sm font-semibold tracking-wider uppercase transition-colors duration-300',
                active === n.key ? 'bg-white text-brand' : 'text-white/90 hover:bg-white/10 hover:text-white']}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/san-pham/#ecohub" class="my-1.5 inline-flex items-center gap-2 self-center rounded-full bg-white px-5 py-2 text-sm font-semibold text-brand transition-all duration-300 hover:-translate-y-0.5 hover:shadow-soft">
        <Icon name="sparkles" class="size-4" /> Chọn ECOHUB
      </a>
    </div>
  </nav>
</header>

<!-- Menu trượt (mobile) -->
<div id="drawer" class="fixed inset-0 z-50" data-drawer hidden>
  <div class="absolute inset-0 bg-ink/50 opacity-0 transition-opacity duration-300 data-[open]:opacity-100" data-menu-close data-drawer-backdrop></div>
  <aside class="absolute inset-y-0 right-0 flex w-[min(88vw,380px)] translate-x-full flex-col gap-5 overflow-y-auto bg-white p-5 shadow-2xl transition-transform duration-300 data-[open]:translate-x-0" role="dialog" aria-modal="true" aria-label="Menu" data-drawer-panel>
    <div class="flex items-center justify-between"><Logo size="sm" /><button class="icon-btn" type="button" aria-label="Đóng menu" data-menu-close><Icon name="close" /></button></div>
    <form action="/san-pham/" method="get" role="search" class="flex items-center gap-2 rounded-full border border-line px-4 focus-within:border-brand">
      <Icon name="search" class="size-5 text-muted" />
      <input type="search" name="q" placeholder="Tìm sản phẩm…" aria-label="Tìm sản phẩm" class="min-h-12 w-full bg-transparent text-base outline-none" />
    </form>
    <ul class="divide-y divide-line">
      {nav.map((n) => (
        <li><a href={n.href} class:list={['flex items-center justify-between py-3.5 text-base font-semibold', active === n.key ? 'text-brand' : 'text-ink']}>{n.label}<Icon name="chevronRight" class="size-5 text-muted" /></a></li>
      ))}
      <li><a href="/gio-hang/" class="flex items-center justify-between py-3.5 text-base font-semibold">Giỏ hàng<Icon name="chevronRight" class="size-5 text-muted" /></a></li>
      <li><a href="/tai-khoan/" class="flex items-center justify-between py-3.5 text-base font-semibold">Tài khoản<Icon name="chevronRight" class="size-5 text-muted" /></a></li>
    </ul>
    <button class="btn btn-primary w-full" type="button" data-open-chat data-menu-close><Icon name="chat" /> Chat với MIO</button>
    <div class="mt-auto space-y-2 rounded-2xl bg-cream p-4 text-sm">
      <a href={telHref} class="flex items-center gap-2 font-semibold text-brand"><Icon name="phone" class="size-4" /> {site.phone}</a>
      <p class="flex items-center gap-2 text-muted"><Icon name="clock" class="size-4" /> {site.hours}</p>
    </div>
  </aside>
</div>
