---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<BaseLayout title="Giỏ hàng" noindex>
  <Breadcrumbs items={[['Giỏ hàng']]} />
  <section class="py-10 sm:py-14">
    <div class="container-x">
      <div class="mb-8"><p class="eyebrow">Giỏ hàng</p><h1 class="h-display">Giỏ hàng của bạn</h1></div>

      <div class="card mx-auto max-w-xl p-10 text-center" data-cart-empty hidden>
        <span class="circle-ic mx-auto"><Icon name="cart" /></span>
        <h2 class="mt-4 text-xl font-bold">Giỏ hàng đang trống</h2>
        <p class="mt-2 text-muted">Khám phá các dòng ECOHUB và phụ kiện để bắt đầu góc xanh thông minh của bạn.</p>
        <a class="btn btn-primary mt-6" href="/san-pham/">Xem sản phẩm <Icon name="arrowRight" /></a>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1fr_360px]" data-cart-wrap hidden>
        <div>
          <div class="hidden grid-cols-[1fr_120px_140px_120px_44px] gap-4 border-b border-line pb-3 text-xs font-bold tracking-wider text-muted uppercase md:grid">
            <span>Sản phẩm</span><span>Đơn giá</span><span>Số lượng</span><span>Thành tiền</span><span class="sr-only">Xóa</span>
          </div>
          <ul class="divide-y divide-line" data-cart-rows></ul>
          <a class="link-arrow mt-6" href="/san-pham/"><Icon name="arrowLeft" /> Tiếp tục mua sắm</a>
        </div>
        <aside class="card h-fit p-6 lg:sticky lg:top-40">
          <h2 class="text-lg font-bold">Tóm tắt</h2>
          <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <span class="text-muted">Tổng cộng (<b data-cart-qty>0</b> sản phẩm)</span>
            <strong class="text-xl whitespace-nowrap text-brand" data-cart-total>—</strong>
          </div>
          <p class="mt-3 text-sm text-muted">Nhân viên VIO GREEN sẽ gọi báo giá và phí vận chuyển khi xác nhận đơn.</p>
          <a class="btn btn-primary mt-5 w-full" href="/dat-hang/">Tiến hành đặt hàng <Icon name="arrowRight" /></a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
