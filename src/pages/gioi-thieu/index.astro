---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PolicyStrip from '../../components/PolicyStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---
<BaseLayout title="Giới thiệu" active="about" description="Câu chuyện thương hiệu, tầm nhìn và sứ mệnh của VIO GREEN – giải pháp không gian xanh đô thị thông minh.">
  <Breadcrumbs items={[['Giới thiệu']]} />

  <!-- Hero kiểu ảnh nền + lớp phủ xanh, chữ bên trái (tham khảo hiệu ứng tatagarden.vn) -->
  <section class="relative isolate overflow-hidden bg-brand-900 text-white">
    <div aria-hidden="true" class="absolute inset-0 -z-10">
      <img src="/assets/bia-1.webp" srcset="/assets/bia-1-800.webp 800w, /assets/bia-1.webp 1680w" sizes="100vw" alt="" class="size-full animate-breath object-cover" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgb(1_54_0/.92)_0%,rgb(1_54_0/.72)_40%,rgb(1_54_0/.25)_75%,rgb(1_54_0/.1))]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(1_54_0/.6),transparent_40%)]"></div>
      <div class="absolute top-0 -left-1/4 h-full w-2/3 animate-sweep bg-[linear-gradient(100deg,transparent,rgb(255_255_255/.08),transparent)]"></div>
    </div>
    <div class="container-x py-20 sm:py-28 lg:py-32" data-reveal>
      <div class="max-w-2xl">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-xs font-semibold tracking-[0.18em] uppercase backdrop-blur"><span class="size-1.5 rounded-full bg-sun"></span>Về VIO GREEN</p>
        <h1 class="text-4xl leading-[1.1] font-extrabold tracking-tight sm:text-5xl lg:text-6xl">Công nghệ thông minh. <span class="text-sun">Không gian xanh.</span> Cuộc sống dễ dàng hơn.</h1>
        <p class="mt-6 max-w-xl text-lg text-white/85">VIO GREEN phát triển các giải pháp chăm sóc không gian xanh đô thị, kết nối công nghệ với thiên nhiên để giúp việc sống xanh trở nên đơn giản, thuận tiện và bền vững hơn.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-light" href="/san-pham/">Khám phá ngay <Icon name="arrowCircle" /></a>
          <a class="btn btn-outline-light backdrop-blur" href="#cau-chuyen">Khám phá câu chuyện <Icon name="arrowRight" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section scroll-mt-28" id="cau-chuyen">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="eyebrow">Câu chuyện thương hiệu</p>
        <h2 class="h-display">Câu chuyện thương hiệu</h2>
        <blockquote class="mt-6 rounded-3xl border-l-4 border-brand bg-cream p-6">
          <Icon name="quote" class="size-8 text-brand-300" />
          <p class="mt-2 text-lg font-semibold text-brand-700 italic">Làm thế nào để con người có thể tận hưởng không gian xanh mà không phải dành quá nhiều thời gian và công sức để duy trì nó?</p>
        </blockquote>
        <p class="mt-6 text-muted sm:text-lg">Từ câu hỏi đó, VIO GREEN hướng đến việc ứng dụng công nghệ vào những công việc chăm sóc cây trồng thường ngày, giúp con người kết nối với thiên nhiên theo một cách đơn giản và phù hợp hơn với nhịp sống đô thị bận rộn.</p>
        <a class="btn btn-primary mt-8" href="/san-pham/">Khám phá ngay <Icon name="arrowCircle" /></a>
      </div>
      <div class="grid grid-cols-3 items-center gap-3" data-reveal style="--d:120ms" aria-hidden="true">
        <div class="aspect-[3/4] translate-y-6 overflow-hidden rounded-3xl"><img src="/assets/hero-2-800.webp" alt="" class="size-full object-cover" loading="lazy" /></div>
        <div class="breath aspect-[3/4] shadow-lift"><img src="/assets/hero-1-800.webp" alt="" class="size-full object-cover object-[30%_center]" loading="lazy" /></div>
        <div class="aspect-[3/4] -translate-y-6 overflow-hidden rounded-3xl"><img src="/assets/hero-3-800.webp" alt="" class="size-full object-cover object-left" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container-x grid gap-6 lg:grid-cols-2">
      <article class="card card-hover relative overflow-hidden p-8 sm:p-10" data-reveal>
        <span aria-hidden="true" class="absolute -top-10 -right-10 size-32 rounded-full bg-brand-50"></span>
        <p class="eyebrow relative">Tầm nhìn (Vision)</p>
        <h2 class="relative text-2xl font-bold sm:text-3xl">Kiến tạo tương lai xanh đô thị</h2>
        <p class="relative mt-4 text-muted">Kiến tạo một tương lai nơi công nghệ và thiên nhiên cùng phát triển trong mọi không gian đô thị. VIO GREEN hướng đến trở thành đơn vị tiên phong tại Việt Nam trong lĩnh vực giải pháp không gian xanh đô thị thông minh, góp phần đưa việc sống xanh trở thành một phần dễ dàng, bền vững và không thể thiếu trong đời sống hiện đại.</p>
      </article>
      <article class="relative overflow-hidden rounded-card bg-brand p-8 text-white shadow-lift sm:p-10" data-reveal style="--d:120ms">
        <span aria-hidden="true" class="absolute -top-10 -right-10 size-32 rounded-full bg-white/10"></span>
        <p class="eyebrow eyebrow-light relative">Sứ mệnh (Mission)</p>
        <h2 class="relative text-2xl font-bold sm:text-3xl">Đưa lối sống xanh gắn liền đô thị</h2>
        <p class="relative mt-4 text-brand-100">Đưa lối sống xanh bền vững gắn liền với cuộc sống đô thị bằng công nghệ thông minh. VIO GREEN phát triển các giải pháp chăm sóc cây trồng tích hợp tưới thông minh, quản lý dinh dưỡng và năng lượng mặt trời, giúp đơn giản hóa việc chăm sóc cây, giải phóng thời gian và trao quyền cho mỗi cá nhân, doanh nghiệp kiến tạo không gian xanh theo cách riêng.</p>
      </article>
    </div>
  </section>

  <PolicyStrip />
  <CtaBand title="Giải pháp xanh thông minh cho đô thị." sub="“Chăm sóc thông minh cho không gian xanh đô thị.”" />
</BaseLayout>
