---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Social from '../../components/Social.astro';
import ContactForm from '../../components/ContactForm.astro';
import PolicyStrip from '../../components/PolicyStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site, telHref } from '../../data/site';
const info = [
  ['phone', 'Hotline tư vấn', site.phone, telHref],
  ['email', 'Hộp thư điện tử', site.email, `mailto:${site.email}`],
  ['pin', 'Trụ sở & Showroom', site.address, `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`],
  ['clock', 'Giờ làm việc', site.hours, ''],
  ...(site.website ? [['globe', 'Website chính thức', site.website.replace(/^https?:\/\//, ''), site.website]] : []),
] as [string, string, string, string][];
---
<BaseLayout title="Liên hệ" active="contact" description="Liên hệ VIO GREEN để được tư vấn giải pháp chăm sóc cây thông minh ECOHUB cho ban công, sân thượng, văn phòng.">
  <Breadcrumbs items={[['Liên hệ']]} />

  <!-- HERO: ảnh bìa (chuyển từ trang Sản phẩm sang, 05/11/2026) – nửa phải mờ trắng, chữ đặt bên phải.
       object-[0%_72%]: trên máy tính ảnh bị cắt trên/dưới, lấy khung thấp xuống để thấy trọn máy (khách yêu cầu 11/11/2026) -->
  <section class="relative isolate overflow-hidden bg-white">
    <div class="relative aspect-[16/9] lg:absolute lg:inset-0 lg:aspect-auto">
      <img src="/assets/banner-san-pham.webp" srcset="/assets/banner-san-pham-800.webp 800w, /assets/banner-san-pham.webp 1680w" sizes="100vw"
        alt="Máy VIO GREEN ECOHUB bên các luống rau trên sân thượng" class="size-full animate-breath object-cover object-[0%_72%]" fetchpriority="high" />
      <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(to_top,white,transparent_35%)] lg:bg-[linear-gradient(to_left,rgb(255_255_255/.96)_0%,rgb(255_255_255/.9)_40%,rgb(255_255_255/.55)_52%,transparent_68%)]"></div>
    </div>
    <div class="container-x relative grid lg:min-h-[480px] lg:grid-cols-[1.35fr_1fr] lg:items-center">
      <div class="-mt-6 pb-12 lg:col-start-2 lg:mt-0 lg:py-16" data-reveal>
        <p class="eyebrow">Liên hệ VIO GREEN</p>
        <h1 class="h-display">Cùng nhau vun trồng<br class="hidden lg:inline" /> lối sống xanh.</h1>
        <p class="mt-4 text-lg text-muted">Bạn đã sẵn sàng mang thiên nhiên xanh mát vào không gian sống của mình? Hãy để lại thông tin, đội ngũ chuyên gia VIO GREEN sẽ đồng hành cùng bạn hiện thực hóa khu vườn mơ ước.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#tu-van" class="btn btn-primary">Gửi yêu cầu tư vấn</a>
          <a href={telHref} class="btn btn-light"><Icon name="phone" /> {site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-12">
        <div class="space-y-5" data-reveal>
          <div class="card p-7 shadow-soft sm:p-8">
            <h2 class="text-2xl font-bold text-brand">Thông tin liên hệ</h2>
            <p class="mt-2 text-sm text-muted">Chúng tôi luôn sẵn sàng lắng nghe và tư vấn giải pháp xanh phù hợp nhất cho không gian của bạn.</p>
            <ul class="mt-6 space-y-5">
              {info.map(([ic, label, value, href]) => (
                <li class="flex gap-4">
                  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-brand text-white"><Icon name={ic as any} class="size-5" /></span>
                  <div class="min-w-0">
                    <p class="text-sm font-semibold">{label}</p>
                    {href ? <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="break-words text-muted hover:text-brand">{value}</a> : <p class="text-muted">{value}</p>}
                  </div>
                </li>
              ))}
            </ul>
            <p class="mt-7 mb-3 text-sm font-semibold text-brand">Kết nối mạng xã hội</p>
            <Social />
          </div>
          <div class="flex items-center gap-4 rounded-card bg-brand p-6 text-white shadow-lift">
            <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-2xl bg-white/15"><Icon name="globe" class="size-6" /></span>
            <div><p class="font-bold">Cam kết chất lượng</p><p class="text-sm text-brand-100">Mỗi sản phẩm VIO GREEN đều được chú trọng về chất lượng, độ bền và hiệu quả vận hành, mang đến giải pháp chăm sóc cây thông minh, an toàn và đáng tin cậy cho người dùng.</p></div>
          </div>
        </div>

        <div class="card scroll-mt-32 p-6 sm:p-8" id="tu-van" data-reveal style="--d:120ms">
          <h2 class="mb-6 text-xl font-bold">Gửi yêu cầu tư vấn</h2>
          <ContactForm source="Trang Liên hệ" />
        </div>
      </div>
    </div>
  </section>

  <PolicyStrip />
  <CtaBand />
</BaseLayout>
